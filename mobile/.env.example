# Copy this file to .env and fill in the real values (ask Umer).
# Never commit .env.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The website address printed tags link to. Leave it empty until the site is deployed, and a tag
# only holds its code. Printed tags stay on the plant, so don't print real ones without it.
EXPO_PUBLIC_SITE_URL=
