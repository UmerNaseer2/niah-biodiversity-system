{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-network": "~57.0.3",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jsqr": "^1.4.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "sql.js": "^1.15.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/css-stub.js",
      "^expo-file-system$": "<rootDir>/jest/expo-file-system.js",
      "^expo-image-manipulator$": "<rootDir>/jest/expo-image-manipulator.js",
      "^expo-sqlite$": "<rootDir>/jest/expo-sqlite.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|decode-uri-component))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "overrides": {
    "decode-uri-component": "0.5.1"
  }
}
