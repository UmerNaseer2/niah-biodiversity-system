# Copy this file to .env.local and fill in the real values (ask Umer).
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# These names are also accepted when using the Supabase CLI/dashboard export.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server only. Never use this in client components or anything starting with NEXT_PUBLIC_.
# The Users and roles page needs it to invite, deactivate and list accounts. It only goes to
# Supabase Auth (src/lib/supabase/admin.ts). Without it the rest of the website still works.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key
