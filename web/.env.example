# Copy this file to .env.local and fill in the real values (ask Umer).
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# These names are also accepted, so the names from the Supabase Connect button or Vercel's
# Supabase integration work as they are. Set one name for the address and one for the key.
# SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# SUPABASE_PUBLISHABLE_KEY=your-anon-key
# SUPABASE_ANON_KEY=your-anon-key

# The website's address, with no slash at the end. Invite and password links return to
# <address>/welcome, and QR codes drawn on this website link to <address>/tag/<code>.
# Without it, invite links use the request origin and QR codes only hold the tag code.
# The phone app has its own setting for this, EXPO_PUBLIC_SITE_URL.
# SITE_URL=https://your-website-address

# Server only. Never use this in client components or anything starting with NEXT_PUBLIC_.
# The Users and roles page needs it to invite, deactivate and list accounts. It only goes to
# Supabase Auth (src/lib/supabase/admin.ts). Without it the rest of the website still works.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key
