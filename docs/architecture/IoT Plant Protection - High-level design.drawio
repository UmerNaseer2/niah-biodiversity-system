<mxfile host="app.diagrams.net"><diagram name="High-level design" id="hld"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Tier 1: Sensor nodes" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="640" height="150" as="geometry"/></mxCell><mxCell id="c4" value="Tier 2: Edge and network" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="640" height="215" as="geometry"/></mxCell><mxCell id="c5" value="Tier 3: Server (Supabase)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="485" width="640" height="160" as="geometry"/></mxCell><mxCell id="c6" value="Other subsystems" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=40;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="100" y="695" width="640" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Environment node&lt;/b&gt;&lt;br&gt;ESP32 with DHT11&lt;br&gt;(temperature, humidity),&lt;br&gt;soil moisture and water&lt;br&gt;drop (rain) sensors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c3"><mxGeometry x="50" y="30" width="170" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Threat node&lt;/b&gt;&lt;br&gt;ESP32 with PIR (movement),&lt;br&gt;MPU 6050 (tilt, shaking)&lt;br&gt;and GPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c3"><mxGeometry x="245" y="30" width="170" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;More sensor nodes&lt;/b&gt;&lt;br&gt;in the same region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="c3"><mxGeometry x="440" y="30" width="170" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Edge device (IoT node), one per forest region&lt;/b&gt;&lt;br&gt;collects readings from every sensor node in its region and runs&lt;br&gt;basic checks, for example a movement threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c4"><mxGeometry x="50" y="30" width="560" height="65" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;AP router / gateway&lt;/b&gt;&lt;br&gt;connects the edge device to the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c4"><mxGeometry x="210" y="145" width="240" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;sensor readings,&lt;br&gt;devices, alerts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c5"><mxGeometry x="50" y="35" width="160" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Ingest API&lt;/b&gt;&lt;br&gt;receives readings&lt;br&gt;from edge devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c5"><mxGeometry x="250" y="45" width="160" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Threat detection&lt;br&gt;and alerts&lt;/b&gt;&lt;br&gt;simple rules first,&lt;br&gt;AI detection later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c5"><mxGeometry x="450" y="40" width="160" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;IoT monitoring dashboard&lt;/b&gt; (part of the web platform)&lt;br&gt;live sensor readings, device locations on a map, list of alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c6"><mxGeometry x="50" y="28" width="560" height="65" as="geometry"/></mxCell><mxCell id="c16" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="790" y="726" width="30" height="60" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.1518;entryY=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Zigbee (prototype: WiFi or cable)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.8482;entryY=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="LoRaWAN (prototype: WiFi)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="HTTPS over the internet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="readings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.1429;entryY=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.8571;entryY=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>